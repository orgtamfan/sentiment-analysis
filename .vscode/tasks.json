{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run research unit tests",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"unittest",
				"discover",
				"-s",
				"tests",
				"-v"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Generate VADER label suggestions",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"src.prepare_labels"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Analyze labeled Reddit comments (full dataset)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"src.sentiment_analysis",
				"--input",
				"data/processed/reddit_comments_labeled.csv",
				"--test-size",
				"0.2",
				"--random-state",
				"42"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Analyze labeled Reddit comments (save to processed snapshot)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"src.sentiment_analysis",
				"--input",
				"data/processed/reddit_comments_labeled.csv",
				"--output-dir",
				"data/processed/reddit_comments_labeled_analysis",
				"--test-size",
				"0.2",
				"--random-state",
				"42"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Analyze manually labeled repository subset",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"src.sentiment_analysis",
				"--input",
				"data/processed/manual_labeled_for_repo/manual_labeled.csv",
				"--output-dir",
				"data/processed/manual_labeled_for_repo",
				"--test-size",
				"0.2",
				"--random-state",
				"42"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Calculate inter-annotator agreement (Cohen and Fleiss Kappa)",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"src.inter_annotator_agreement",
				"--input",
				"data/processed/manual_label.csv",
				"--by-game"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}
